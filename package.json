{
  "name": "graphql-codegen-simple-zod",
  "version": "1.0.0",
  "description": "GraphQL Code Generator plugin that creates Zod schemas from GraphQL types.",
  "keywords": [
    "codegen",
    "graphql",
    "graphql-codegen",
    "validation",
    "zod"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^7.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@graphql-codegen/core": "^6.2.0",
    "@types/node": "^26.1.1",
    "graphql": "^17.0.2",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "graphql": "^17.0.2",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
